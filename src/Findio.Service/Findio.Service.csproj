<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>Findio.Service</RootNamespace>
    <AssemblyName>Findio.Service</AssemblyName>
    <Product>Findio</Product>
    <AssemblyTitle>Findio 索引服务</AssemblyTitle>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU;x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Findio.Shared\Findio.Shared.csproj" />
  </ItemGroup>
</Project>
