<?xml version="1.0" encoding="utf-8"?>
<!--
  界面尺寸令牌：间距、字号、圆角、描边、控件高度。
  取值以 1.1.3 已交付并被用户确认的界面为准（见 docs/界面设计规范.md），不发明新数值。
  颜色令牌在 Themes.xaml，本文件不重复定义颜色。
  约定：XAML / C# 里这些属性只允许引用本文件的键或 Themes.xaml 的画刷；
        0 与 1px 发丝线允许内联；其余裸数字必须进 tools/design-token-baseline.json 并写明理由。
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========== 间距阶梯：0 / 2 / 4 / 6 / 8 / 10 / 12 / 16 / 20 / 24 ========== -->
    <x:Double x:Key="LpSpace0">0</x:Double>
    <x:Double x:Key="LpSpaceXxs">2</x:Double>
    <x:Double x:Key="LpSpaceXs">4</x:Double>
    <x:Double x:Key="LpSpaceS">6</x:Double>
    <x:Double x:Key="LpSpaceM">8</x:Double>
    <x:Double x:Key="LpSpaceL">10</x:Double>
    <x:Double x:Key="LpSpaceXl">12</x:Double>
    <x:Double x:Key="LpSpace2xl">16</x:Double>
    <x:Double x:Key="LpSpace3xl">20</x:Double>
    <x:Double x:Key="LpSpace4xl">24</x:Double>

    <!-- 语义间距：页面与对话框的固定留白，不进通用阶梯 -->
    <x:Double x:Key="LpSpacePage">18</x:Double>
    <x:Double x:Key="LpSpaceSection">22</x:Double>
    <x:Double x:Key="LpSpaceDialog">26</x:Double>

    <!-- ========== 字号阶梯 ========== -->
    <x:Double x:Key="LpTextCaption">9.5</x:Double>
    <x:Double x:Key="LpTextLabel">10</x:Double>
    <x:Double x:Key="LpTextBodySmall">10.5</x:Double>
    <x:Double x:Key="LpTextBody">11</x:Double>
    <x:Double x:Key="LpTextButton">11.5</x:Double>
    <x:Double x:Key="LpTextNav">12</x:Double>
    <x:Double x:Key="LpTextBase">12.5</x:Double>
    <x:Double x:Key="LpTextMenu">13</x:Double>
    <x:Double x:Key="LpTextSubtitle">14</x:Double>
    <x:Double x:Key="LpTextSectionTitle">16</x:Double>
    <x:Double x:Key="LpTextTitle">20</x:Double>

    <!-- ========== 行高 ========== -->
    <x:Double x:Key="LpLineTight">15</x:Double>
    <x:Double x:Key="LpLineBase">17</x:Double>
    <x:Double x:Key="LpLineRelaxed">19</x:Double>

    <!-- ========== 圆角 ========== -->
    <CornerRadius x:Key="LpRadiusNone">0</CornerRadius>
    <CornerRadius x:Key="LpRadiusKbd">4</CornerRadius>
    <CornerRadius x:Key="LpRadiusControl">6</CornerRadius>
    <CornerRadius x:Key="LpRadiusButton">7</CornerRadius>
    <CornerRadius x:Key="LpRadiusCard">8</CornerRadius>
    <CornerRadius x:Key="LpRadiusWindow">8</CornerRadius>
    <CornerRadius x:Key="LpRadiusLarge">10</CornerRadius>
    <CornerRadius x:Key="LpRadiusPill">999</CornerRadius>

    <!-- ========== 描边 ========== -->
    <Thickness x:Key="LpStrokeNone">0</Thickness>
    <Thickness x:Key="LpStrokeHairline">1</Thickness>
    <Thickness x:Key="LpStrokeEmphasis">2</Thickness>

    <!-- ========== 控件高度 ========== -->
    <x:Double x:Key="LpSizeKbd">17</x:Double>
    <x:Double x:Key="LpSizeKbdLarge">20</x:Double>
    <x:Double x:Key="LpSizeSelect">26</x:Double>
    <x:Double x:Key="LpSizeTool">28</x:Double>
    <x:Double x:Key="LpSizeButton">30</x:Double>
    <x:Double x:Key="LpSizeInput">34</x:Double>
    <x:Double x:Key="LpSizeNav">36</x:Double>
    <x:Double x:Key="LpSizeCaption">40</x:Double>
    <x:Double x:Key="LpSizeLarge">44</x:Double>
</ResourceDictionary>
